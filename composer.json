{
    "name": "damienlagae/vmlct-website",
    "description": "Van Moer Logistics Cycle Team website built with Symfony 8, providing information about the team, news, and events.",
    "license": "proprietary",
    "type": "project",
    "authors": [
        {
            "name": "Damien Lagae",
            "email": "damienlagae@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "damienharper/auditor-bundle": "^7.2",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "league/flysystem-bundle": "^3.7",
        "liip/imagine-bundle": "^2.17",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/asset": "~8.0.0",
        "symfony/asset-mapper": "~8.0.0",
        "symfony/console": "~8.0.0",
        "symfony/doctrine-messenger": "~8.0.0",
        "symfony/dotenv": "~8.0.0",
        "symfony/expression-language": "~8.0.0",
        "symfony/flex": "^2",
        "symfony/form": "~8.0.0",
        "symfony/framework-bundle": "~8.0.0",
        "symfony/html-sanitizer": "8.0.*",
        "symfony/http-client": "~8.0.0",
        "symfony/intl": "~8.0.0",
        "symfony/mailer": "~8.0.0",
        "symfony/mime": "~8.0.0",
        "symfony/monolog-bundle": "^3.0 || ^4.0",
        "symfony/notifier": "~8.0.0",
        "symfony/process": "~8.0.0",
        "symfony/property-access": "~8.0.0",
        "symfony/property-info": "~8.0.0",
        "symfony/runtime": "~8.0.0",
        "symfony/security-bundle": "~8.0.0",
        "symfony/serializer": "~8.0.0",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/string": "~8.0.0",
        "symfony/translation": "~8.0.0",
        "symfony/twig-bundle": "~8.0.0",
        "symfony/uid": "8.0.*",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-live-component": "*",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "~8.0.0",
        "symfony/web-link": "~8.0.0",
        "symfony/yaml": "~8.0.0",
        "twig/extra-bundle": "^2.12 || ^3.0",
        "twig/intl-extra": "^3.24",
        "twig/twig": "^2.12 || ^3.0",
        "vich/uploader-bundle": "^2.9"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "ergebnis/composer-normalize": "^2.51",
        "phpunit/phpunit": "^13.1",
        "symfony/browser-kit": "~8.0.0",
        "symfony/css-selector": "~8.0.0",
        "symfony/debug-bundle": "~8.0.0",
        "symfony/maker-bundle": "^1.0",
        "symfony/stopwatch": "~8.0.0",
        "symfony/web-profiler-bundle": "~8.0.0",
        "zenstruck/foundry": "^2.9"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": false,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "docker": true,
            "require": "8.0.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "csf": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff",
        "csf-fix": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "stan": "tools/phpstan/vendor/bin/phpstan analyse",
        "rector": "tools/rector/vendor/bin/rector process --dry-run",
        "rector-fix": "tools/rector/vendor/bin/rector process",
        "test": "bin/phpunit",
        "qa": [
            "@csf",
            "@stan",
            "@test"
        ],
        "lint-yaml": "bin/console lint:yaml config --parse-tags",
        "lint-twig": "bin/console lint:twig src/Shared/templates src/Page/templates src/Module",
        "lint-container": "bin/console lint:container",
        "lint-composer": "@composer validate --no-check-publish",
        "lint": [
            "@lint-yaml",
            "@lint-container",
            "@lint-twig",
            "@lint-composer"
        ]
    }
}
