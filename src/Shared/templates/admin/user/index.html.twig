{% extends '@Shared/admin/layout.html.twig' %}

{% block title %}{{ 'user.admin.index.title'|trans }}{% endblock %}

{% block admin_content %}
    <header class="admin-page-header mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="admin-page-header__title">{{ 'user.admin.index.title'|trans }}</h1>
            <p class="admin-page-header__subtitle">{{ 'user.admin.index.subtitle'|trans }}</p>
        </div>
        {% if is_granted(enum('App\\Shared\\Security\\Permissions\\UserPermissions').create.value) %}
            <a href="{{ path('admin_user_create') }}" class="btn btn-primary">
                <twig:ux:icon name="bi:plus-lg" /> {{ 'user.admin.actions.create'|trans }}
            </a>
        {% endif %}
    </header>

    {% for label, messages in app.flashes(['success', 'danger']) %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="admin-stat-card admin-stat-card--primary">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:people" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ stats.total }}</div>
                    <div class="admin-stat-card__hint">{{ 'user.admin.stats.total'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="admin-stat-card admin-stat-card--success">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:check-circle" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ stats.active }}</div>
                    <div class="admin-stat-card__hint">{{ 'user.admin.stats.active'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="admin-stat-card admin-stat-card--info">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:shield-check" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ stats.admins }}</div>
                    <div class="admin-stat-card__hint">{{ 'user.admin.stats.admins'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{ 'user.admin.table.email'|trans }}</th>
                        <th scope="col">{{ 'user.admin.table.name'|trans }}</th>
                        <th scope="col">{{ 'user.admin.table.roles'|trans }}</th>
                        <th scope="col" style="width: 120px;">{{ 'user.admin.table.status'|trans }}</th>
                        <th scope="col" class="text-end" style="width: 140px;">{{ 'user.admin.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td><strong>{{ user.email }}</strong></td>
                            <td>{{ user.fullName }}</td>
                            <td>
                                {% for role in user.roles %}
                                    <code class="small">{{ role }}</code>{% if not loop.last %} {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {% if user.active %}
                                    <span class="badge bg-success-subtle text-success">{{ 'user.admin.status.active'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary">{{ 'user.admin.status.inactive'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if is_granted(enum('App\\Shared\\Security\\Permissions\\UserPermissions').edit.value, user) %}
                                    <a href="{{ path('admin_user_edit', {id: user.id}) }}"
                                       class="btn btn-sm btn-outline-primary"
                                       title="{{ 'user.admin.actions.edit'|trans }}">
                                        <twig:ux:icon name="bi:pencil" />
                                    </a>
                                {% endif %}
                                {% if user != app.user and is_granted(enum('App\\Shared\\Security\\Permissions\\UserPermissions').delete.value, user) %}
                                    <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}"
                                          class="d-inline"
                                          data-controller="confirm"
                                          data-confirm-message-value="{{ 'user.admin.actions.confirm_delete'|trans({'%email%': user.email}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="{{ 'user.admin.actions.delete'|trans }}">
                                            <twig:ux:icon name="bi:trash" />
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                {{ 'user.admin.empty'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
