<div{{ attributes.defaults({class: 'content-editor'}) }}>
    <input type="hidden" name="{{ fieldName }}" value="{{ blocks|json_encode|e('html_attr') }}">

    {% if blocks is empty %}
        <div class="alert alert-light border small mb-3" data-testid="content-editor-empty">
            <twig:ux:icon name="bi:info-circle" /> {{ 'content.editor.empty'|trans }}
        </div>
    {% endif %}

    <ol class="content-editor__list list-unstyled mb-3" data-testid="content-editor-list">
        {% for index, block in blocks %}
            <li class="content-editor__block card border mb-3" data-block-index="{{ index }}" data-block-type="{{ block.type }}">
                <div class="card-header d-flex justify-content-between align-items-center bg-light py-2">
                    <span class="d-inline-flex align-items-center gap-2 small text-muted">
                        <twig:ux:icon name="bi:grip-vertical" />
                        <strong class="text-uppercase">{{ ('content.editor.block.' ~ block.type)|trans }}</strong>
                        <span class="badge text-bg-light">#{{ index + 1 }}</span>
                    </span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary"
                                data-action="live#action"
                                data-live-action-param="moveUp"
                                data-live-index-param="{{ index }}"
                                {% if index == 0 %}disabled{% endif %}
                                title="{{ 'content.editor.actions.up'|trans }}"
                                aria-label="{{ 'content.editor.actions.up'|trans }}">
                            <twig:ux:icon name="bi:arrow-up" />
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                                data-action="live#action"
                                data-live-action-param="moveDown"
                                data-live-index-param="{{ index }}"
                                {% if index == blocks|length - 1 %}disabled{% endif %}
                                title="{{ 'content.editor.actions.down'|trans }}"
                                aria-label="{{ 'content.editor.actions.down'|trans }}">
                            <twig:ux:icon name="bi:arrow-down" />
                        </button>
                        <button type="button" class="btn btn-outline-danger"
                                data-action="live#action"
                                data-live-action-param="deleteBlock"
                                data-live-index-param="{{ index }}"
                                title="{{ 'content.editor.actions.remove'|trans }}"
                                aria-label="{{ 'content.editor.actions.remove'|trans }}">
                            <twig:ux:icon name="bi:trash" />
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    {% include '@Shared/admin/content-editor/blocks/_' ~ block.type ~ '.html.twig' ignore missing with {block: block, index: index} only %}
                </div>
            </li>
        {% endfor %}
    </ol>

    <div class="content-editor__add-bar d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted small me-2">{{ 'content.editor.add'|trans }}</span>
        <button type="button" class="btn btn-outline-primary btn-sm"
                data-action="live#action"
                data-live-action-param="appendBlock"
                data-live-type-param="text">
            <twig:ux:icon name="bi:paragraph" /> {{ 'content.editor.block.text'|trans }}
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm"
                data-action="live#action"
                data-live-action-param="appendBlock"
                data-live-type-param="heading">
            <twig:ux:icon name="bi:type-h2" /> {{ 'content.editor.block.heading'|trans }}
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm"
                data-action="live#action"
                data-live-action-param="appendBlock"
                data-live-type-param="image">
            <twig:ux:icon name="bi:image" /> {{ 'content.editor.block.image'|trans }}
        </button>
    </div>
</div>
