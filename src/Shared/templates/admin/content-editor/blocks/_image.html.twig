{% set blockId = block.id|default('image-' ~ index) %}
<div data-controller="content-image-upload"
     data-content-image-upload-url-value="{{ path('admin_content_upload_image') }}">
    <div class="row g-3 align-items-start">
        <div class="col-md-4">
            {% if block.path is not empty %}
                <img data-content-image-upload-target="preview"
                     src="{{ block.path|imagine_filter('article_inline_thumb') }}"
                     alt=""
                     class="img-fluid rounded border" />
            {% else %}
                <img data-content-image-upload-target="preview" hidden alt="" class="img-fluid rounded border" />
                <div class="admin-form__placeholder">
                    <twig:ux:icon name="bi:image" />
                    <span class="small">{{ 'content.editor.field.image_empty'|trans }}</span>
                </div>
            {% endif %}
        </div>
        <div class="col-md-8">
            <input type="hidden"
                   data-content-image-upload-target="input"
                   value="{{ block.path|default('') }}"
                   data-model="debounce(100)|blocks.{{ index }}.path">

            <div class="mb-3">
                <label class="form-label small text-uppercase fw-semibold" for="block-image-file-{{ blockId }}">
                    {{ 'content.editor.field.image_file'|trans }}
                </label>
                <input id="block-image-file-{{ blockId }}"
                       type="file"
                       class="form-control"
                       accept="image/png,image/jpeg,image/webp"
                       data-content-image-upload-target="file"
                       data-action="change->content-image-upload#upload">
                <small class="form-text text-muted"
                       data-content-image-upload-target="status"
                       data-uploading="{{ 'content.editor.field.image_uploading'|trans }}"
                       data-done="{{ 'content.editor.field.image_uploaded'|trans }}"
                       data-error="{{ 'content.editor.field.image_upload_failed'|trans }}">
                    {{ 'content.editor.field.image_file_help'|trans }}
                </small>
            </div>

            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label small text-uppercase fw-semibold" for="block-image-alt-{{ blockId }}">
                        {{ 'content.editor.field.image_alt'|trans }}
                    </label>
                    <input id="block-image-alt-{{ blockId }}"
                           type="text"
                           class="form-control"
                           value="{{ block.alt|default('') }}"
                           data-model="debounce(400)|blocks.{{ index }}.alt">
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-uppercase fw-semibold" for="block-image-alignment-{{ blockId }}">
                        {{ 'content.editor.field.image_alignment'|trans }}
                    </label>
                    {% set currentAlignment = block.alignment|default('center') %}
                    <select id="block-image-alignment-{{ blockId }}"
                            class="form-select"
                            data-model="blocks.{{ index }}.alignment">
                        <option value="left"{% if currentAlignment == 'left' %} selected{% endif %}>{{ 'content.editor.alignment.left'|trans }}</option>
                        <option value="center"{% if currentAlignment == 'center' %} selected{% endif %}>{{ 'content.editor.alignment.center'|trans }}</option>
                        <option value="right"{% if currentAlignment == 'right' %} selected{% endif %}>{{ 'content.editor.alignment.right'|trans }}</option>
                        <option value="full"{% if currentAlignment == 'full' %} selected{% endif %}>{{ 'content.editor.alignment.full'|trans }}</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small text-uppercase fw-semibold" for="block-image-caption-{{ blockId }}">
                        {{ 'content.editor.field.image_caption'|trans }}
                    </label>
                    <input id="block-image-caption-{{ blockId }}"
                           type="text"
                           class="form-control"
                           value="{{ block.caption|default('') }}"
                           data-model="debounce(400)|blocks.{{ index }}.caption">
                </div>
            </div>
        </div>
    </div>
</div>
