{% set user = this.currentUser %}
<header class="admin-header">
    <div class="admin-header__inner">
        <a href="{{ path('admin_dashboard') }}" class="admin-header__brand">
            <span class="admin-header__brand-logo">
                <img src="{{ asset('img/logo/van_moer_logistics_cycling_team.png') }}"
                     alt="{{ 'app.name'|trans }}" height="34" />
            </span>
            <span class="admin-header__brand-text">
                <strong>VMLCT</strong>
                <small>{{ 'admin.header.subtitle'|trans }}</small>
            </span>
        </a>

        <nav class="admin-header__nav" aria-label="{{ 'admin.header.nav_label'|trans }}">
            <a href="{{ path('home') }}" class="admin-header__nav-link">
                <twig:ux:icon name="bi:house" />
                <span>{{ 'admin.header.view_site'|trans }}</span>
            </a>
        </nav>

        {% if user %}
            <div class="admin-header__user dropdown">
                <button class="admin-header__user-btn dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    {% if user.avatarUrl %}
                        <img src="{{ user.avatarUrl }}" alt="{{ user.fullName }}" class="admin-header__avatar" />
                    {% else %}
                        <span class="admin-header__avatar-fallback">
                            {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                        </span>
                    {% endif %}
                    <span class="admin-header__user-name">{{ user.fullName }}</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="{{ path('profile') }}">
                            <twig:ux:icon name="bi:person" /> {{ 'admin.header.profile'|trans }}
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="{{ path('logout') }}">
                            <twig:ux:icon name="bi:box-arrow-right" /> {{ 'admin.logout'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        {% endif %}
    </div>
</header>
