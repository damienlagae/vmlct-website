{% extends '@Shared/base.html.twig' %}

{% block title %}{{ page.metaTitle ?: page.title }}{% endblock %}

{% block meta_tags %}
    {{ parent() }}
    {% if page.metaDescription %}
        <meta name="description" content="{{ page.metaDescription }}">
        <meta property="og:description" content="{{ page.metaDescription }}">
    {% endif %}
{% endblock %}

{% block body %}
    <article class="page-article">
        <header class="page-article__header">
            <div class="container text-center">
                <h1 class="section-title">{{ page.title }}</h1>
                <div class="title-underline mx-auto"></div>
                {% if page.excerpt %}
                    <p class="page-article__lead">{{ page.excerpt }}</p>
                {% endif %}
            </div>
        </header>

        <div class="page-article__body">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="page-article__body-inner">
                            <div class="article-content">
                                {% if blocks is empty %}
                                    <p class="text-muted"><em>{{ 'page.public.body_coming_soon'|trans }}</em></p>
                                {% else %}
                                    {% include '@Shared/blocks/_render.html.twig' with {blocks: blocks} %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>
{% endblock %}
