{{ form_start(form) }}
    <div class="card shadow-sm">
        <div class="card-body p-4">
            {{ form_row(form.name) }}
            {{ form_row(form.websiteUrl) }}
            {{ form_row(form.logoUrl) }}
            {{ form_row(form.displayOrder) }}
            {{ form_row(form.active) }}
        </div>
        <div class="card-footer d-flex justify-content-between bg-white border-top">
            <a href="{{ path('admin_sponsor_index') }}" class="btn btn-link">{{ 'admin.form.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ submitLabel|trans }}</button>
        </div>
    </div>
{{ form_end(form) }}
