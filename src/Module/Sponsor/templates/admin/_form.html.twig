{{ form_start(form) }}
    <div class="card shadow-sm">
        <div class="card-body p-4">
            {{ form_row(form.name) }}
            {{ form_row(form.websiteUrl) }}

            {% set sponsor = form.vars.data %}
            {% if sponsor is not null and sponsor.logoPath %}
                <div class="mb-3">
                    <label class="form-label d-block">{{ 'sponsor.form.current_logo'|trans }}</label>
                    <img src="{{ sponsor.logoPath|imagine_filter('sponsor_logo') }}"
                         alt="{{ sponsor.name }}"
                         style="max-height: 100px;" class="border rounded p-1 bg-white" />
                </div>
            {% endif %}

            {{ form_row(form.logoFile) }}
            {{ form_row(form.displayOrder) }}
            {{ form_row(form.active) }}
        </div>
        <div class="card-footer d-flex justify-content-between bg-white border-top">
            <a href="{{ path('admin_sponsor_index') }}" class="btn btn-link">{{ 'admin.form.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ submitLabel|trans }}</button>
        </div>
    </div>
{{ form_end(form) }}
