{{ form_start(form) }}
    <div class="card shadow-sm">
        <div class="card-body p-4">
            {{ form_row(form.name) }}
            {{ form_row(form.websiteUrl) }}
            {% if form.parent and form.parent.vars.data is not null and form.parent.vars.data.logoPath %}
                <div class="mb-3">
                    <label class="form-label">{{ 'sponsor.form.current_logo'|trans }}</label>
                    <div>
                        <img src="{{ form.parent.vars.data.logoPath|imagine_filter('sponsor_logo') }}"
                             alt="{{ form.parent.vars.data.name }}"
                             style="max-height: 80px;" class="border rounded p-1 bg-white" />
                    </div>
                </div>
            {% endif %}
            {{ form_row(form.logo) }}
            {{ form_row(form.displayOrder) }}
            {{ form_row(form.active) }}
        </div>
        <div class="card-footer d-flex justify-content-between bg-white border-top">
            <a href="{{ path('admin_sponsor_index') }}" class="btn btn-link">{{ 'admin.form.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ submitLabel|trans }}</button>
        </div>
    </div>
{{ form_end(form) }}
