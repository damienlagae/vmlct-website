<div {{ attributes.defaults({ class: 'row g-3 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 justify-content-center' }) }}>
    {% for sponsor in this.sponsors %}
        <div class="col">
            {% if sponsor.websiteUrl %}
                <a href="{{ sponsor.websiteUrl }}" target="_blank" rel="noopener" class="sponsor-cell d-flex">
                    {% if sponsor.logoPath %}
                        <img src="{{ sponsor.logoPath|imagine_filter('sponsor_logo') }}" alt="{{ sponsor.name }}" loading="lazy" />
                    {% else %}
                        <span class="sponsor-name">{{ sponsor.name }}</span>
                    {% endif %}
                </a>
            {% else %}
                <div class="sponsor-cell">
                    {% if sponsor.logoPath %}
                        <img src="{{ sponsor.logoPath|imagine_filter('sponsor_logo') }}" alt="{{ sponsor.name }}" loading="lazy" />
                    {% else %}
                        <span class="sponsor-name">{{ sponsor.name }}</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="col text-center text-muted">
            <em>{{ 'sponsor.empty'|trans }}</em>
        </div>
    {% endfor %}
</div>
