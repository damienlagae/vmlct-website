{% extends '@Shared/admin/layout.html.twig' %}

{% block title %}{{ 'programme.admin.index.title'|trans }}{% endblock %}

{% block admin_content %}
    <header class="admin-page-header mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="admin-page-header__title">{{ 'programme.admin.index.title'|trans }}</h1>
            <p class="admin-page-header__subtitle">{{ 'programme.admin.index.subtitle'|trans }}</p>
        </div>
        {% if is_granted(enum('App\\Module\\Programme\\Security\\ProgrammePermissions').create.value) %}
            <a href="{{ path('admin_race_create') }}" class="btn btn-primary">
                <twig:ux:icon name="bi:plus-lg" /> {{ 'programme.admin.actions.create'|trans }}
            </a>
        {% endif %}
    </header>

    {% for label, messages in app.flashes(['success', 'danger']) %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="admin-stat-card admin-stat-card--primary">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:calendar-event" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ upcoming|length }}</div>
                    <div class="admin-stat-card__hint">{{ 'programme.admin.stats.upcoming'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="admin-stat-card admin-stat-card--neutral">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:archive" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ past|length }}</div>
                    <div class="admin-stat-card__hint">{{ 'programme.admin.stats.past'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    {% set sections = [
        { title: 'programme.admin.section.upcoming', races: upcoming, empty: 'programme.admin.empty.upcoming' },
        { title: 'programme.admin.section.past', races: past, empty: 'programme.admin.empty.past' },
    ] %}

    {% for section in sections %}
        <h2 class="h5 mt-4 mb-3">{{ section.title|trans }}</h2>
        {% if section.races is empty %}
            <p class="text-muted">{{ section.empty|trans }}</p>
        {% else %}
            <div class="card shadow-sm mb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'programme.admin.table.name'|trans }}</th>
                                <th style="width: 180px;">{{ 'programme.admin.table.startsAt'|trans }}</th>
                                <th>{{ 'programme.admin.table.location'|trans }}</th>
                                <th style="width: 140px;">{{ 'programme.admin.table.discipline'|trans }}</th>
                                <th class="text-end" style="width: 140px;">{{ 'programme.admin.table.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for race in section.races %}
                                <tr>
                                    <td>
                                        <strong>{{ race.name }}</strong>
                                        {% if race.categories|length > 0 %}
                                            <div class="small text-muted">
                                                {% for cat in race.categories %}
                                                    <span class="badge bg-secondary-subtle text-secondary">{{ ('programme.category.' ~ cat.value)|trans }}</span>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <time datetime="{{ race.startsAt|date('c') }}">
                                            {{ race.startsAt|format_datetime(locale='nl', pattern='dd/MM/yyyy HH:mm') }}
                                        </time>
                                    </td>
                                    <td>{{ race.location }}</td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">
                                            {{ ('programme.discipline.' ~ race.discipline.value)|trans }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        {% if is_granted(enum('App\\Module\\Programme\\Security\\ProgrammePermissions').edit.value, race) %}
                                            <a href="{{ path('admin_race_edit', {id: race.id}) }}" class="btn btn-sm btn-outline-primary">
                                                <twig:ux:icon name="bi:pencil" />
                                            </a>
                                        {% endif %}
                                        {% if is_granted(enum('App\\Module\\Programme\\Security\\ProgrammePermissions').delete.value, race) %}
                                            <form method="post" action="{{ path('admin_race_delete', {id: race.id}) }}"
                                                  class="d-inline"
                                                  data-controller="confirm"
                                                  data-confirm-message-value="{{ 'programme.admin.actions.confirm_delete'|trans({'%name%': race.name}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-race-' ~ race.id) }}" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <twig:ux:icon name="bi:trash" />
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
