{% extends '@Shared/admin/layout.html.twig' %}

{% block title %}{{ 'news.admin.index.title'|trans }}{% endblock %}

{% block admin_content %}
    <header class="admin-page-header mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="admin-page-header__title">{{ 'news.admin.index.title'|trans }}</h1>
            <p class="admin-page-header__subtitle">{{ 'news.admin.index.subtitle'|trans }}</p>
        </div>
        {% if is_granted(enum('App\\Module\\News\\Security\\NewsPermissions').create.value) %}
            <a href="{{ path('admin_article_create') }}" class="btn btn-primary">
                <twig:ux:icon name="bi:plus-lg" /> {{ 'news.admin.actions.create'|trans }}
            </a>
        {% endif %}
    </header>

    {% for label, messages in app.flashes(['success', 'danger']) %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="admin-stat-card admin-stat-card--primary">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:newspaper" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ stats.total }}</div>
                    <div class="admin-stat-card__hint">{{ 'news.admin.stats.total'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="admin-stat-card admin-stat-card--success">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:check-circle" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ stats.published }}</div>
                    <div class="admin-stat-card__hint">{{ 'news.admin.stats.published'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="admin-stat-card admin-stat-card--neutral">
                <div class="admin-stat-card__icon"><twig:ux:icon name="bi:pencil-square" /></div>
                <div class="admin-stat-card__body">
                    <div class="admin-stat-card__label">{{ stats.draft }}</div>
                    <div class="admin-stat-card__hint">{{ 'news.admin.stats.draft'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{ 'news.admin.table.title'|trans }}</th>
                        <th scope="col">{{ 'news.admin.table.author'|trans }}</th>
                        <th scope="col" style="width: 180px;">{{ 'news.admin.table.publishedAt'|trans }}</th>
                        <th scope="col" style="width: 120px;">{{ 'news.admin.table.status'|trans }}</th>
                        <th scope="col" class="text-end" style="width: 140px;">{{ 'news.admin.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for article in articles %}
                        <tr>
                            <td>
                                <strong>{{ article.title }}</strong>
                                <div class="small text-muted">/{{ article.slug }}</div>
                            </td>
                            <td>{{ article.author ? article.author.fullName : '—' }}</td>
                            <td>
                                {% if article.publishedAt %}
                                    <span class="small">{{ article.publishedAt|format_datetime(locale='nl', pattern='dd/MM/yyyy HH:mm') }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if article.isPublished %}
                                    <span class="badge bg-success-subtle text-success">{{ 'news.admin.status.published'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary">{{ 'news.admin.status.draft'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if is_granted(enum('App\\Module\\News\\Security\\NewsPermissions').edit.value, article) %}
                                    <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <twig:ux:icon name="bi:pencil" />
                                    </a>
                                {% endif %}
                                {% if is_granted(enum('App\\Module\\News\\Security\\NewsPermissions').delete.value, article) %}
                                    <form method="post" action="{{ path('admin_article_delete', {id: article.id}) }}"
                                          class="d-inline"
                                          data-controller="confirm"
                                          data-confirm-message-value="{{ 'news.admin.actions.confirm_delete'|trans({'%title%': article.title}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-article-' ~ article.id) }}" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <twig:ux:icon name="bi:trash" />
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">{{ 'news.admin.empty'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
