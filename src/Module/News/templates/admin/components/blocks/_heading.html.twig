<div class="row g-3">
    <div class="col-md-9">
        <label class="form-label small text-uppercase fw-semibold" for="block-heading-text-{{ index }}">
            {{ 'news.editor.field.heading_text'|trans }}
        </label>
        <input id="block-heading-text-{{ index }}"
               type="text"
               class="form-control"
               value="{{ block.text ?? '' }}"
               data-model="debounce(400)|blocks.{{ index }}.text">
    </div>
    <div class="col-md-3">
        <label class="form-label small text-uppercase fw-semibold" for="block-heading-level-{{ index }}">
            {{ 'news.editor.field.heading_level'|trans }}
        </label>
        <select id="block-heading-level-{{ index }}"
                class="form-select"
                data-model="blocks.{{ index }}.level">
            {% set currentLevel = block.level ?? 'h2' %}
            <option value="h2"{% if currentLevel == 'h2' %} selected{% endif %}>H2</option>
            <option value="h3"{% if currentLevel == 'h3' %} selected{% endif %}>H3</option>
            <option value="h4"{% if currentLevel == 'h4' %} selected{% endif %}>H4</option>
        </select>
    </div>
</div>
