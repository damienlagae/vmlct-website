{% extends '@Shared/base.html.twig' %}

{% block title %}{{ 'news.public.title'|trans }}{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container">
            <header class="text-center mb-5">
                <h1 class="section-title">{{ 'news.public.title'|trans }}</h1>
                <div class="title-underline mx-auto"></div>
                <p class="text-muted mt-3">{{ 'news.public.intro'|trans }}</p>
            </header>

            {% if total == 0 %}
                <p class="text-muted text-center">{{ 'news.public.empty'|trans }}</p>
            {% else %}
                <div class="news-list">
                    {% for article in articles %}
                        <article class="news-row{% if loop.index is even %} news-row--reversed{% endif %}">
                            <a href="{{ path('news_show', {slug: article.slug}) }}" class="news-row__media">
                                {% if article.coverPath %}
                                    <img src="{{ article.coverPath|imagine_filter('article_card') }}"
                                         alt="{{ article.title }}"
                                         loading="lazy" />
                                {% else %}
                                    <span class="news-row__placeholder">
                                        <twig:ux:icon name="bi:newspaper" />
                                    </span>
                                {% endif %}
                            </a>
                            <div class="news-row__body">
                                {% if article.publishedAt %}
                                    <p class="news-row__date">
                                        <twig:ux:icon name="bi:calendar3" />
                                        <time datetime="{{ article.publishedAt|date('c') }}">
                                            {{ article.publishedAt|format_datetime(locale='nl', pattern='dd MMMM yyyy') }}
                                        </time>
                                    </p>
                                {% endif %}
                                <h2 class="news-row__title">
                                    <a href="{{ path('news_show', {slug: article.slug}) }}">{{ article.title }}</a>
                                </h2>
                                {% if article.excerpt %}
                                    <p class="news-row__excerpt">{{ article.excerpt }}</p>
                                {% endif %}
                                <div class="news-row__footer">
                                    <a href="{{ path('news_show', {slug: article.slug}) }}"
                                       class="news-row__more">
                                        {{ 'news.public.read_more'|trans }}
                                        <twig:ux:icon name="bi:arrow-right" />
                                    </a>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>

                {% if totalPages > 1 %}
                    <nav class="d-flex justify-content-center mt-5" aria-label="{{ 'news.public.pagination'|trans }}">
                        <ul class="pagination">
                            <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                                <a class="page-link" href="{{ path('news_index', {page: max(1, currentPage - 1)}) }}">
                                    {{ 'news.public.prev'|trans }}
                                </a>
                            </li>
                            {% for p in 1..totalPages %}
                                <li class="page-item {{ p == currentPage ? 'active' }}">
                                    <a class="page-link" href="{{ path('news_index', {page: p}) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                                <a class="page-link" href="{{ path('news_index', {page: min(totalPages, currentPage + 1)}) }}">
                                    {{ 'news.public.next'|trans }}
                                </a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            {% endif %}
        </div>
    </section>
{% endblock %}
