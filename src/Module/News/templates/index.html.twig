{% extends '@Shared/base.html.twig' %}

{% block title %}{{ 'news.public.title'|trans }}{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container">
            <header class="text-center mb-5">
                <h2 class="section-title">{{ 'news.public.title'|trans }}</h2>
                <div class="title-underline"></div>
                <p class="text-muted mt-3">{{ 'news.public.intro'|trans }}</p>
            </header>

            {% if total == 0 %}
                <p class="text-muted text-center">{{ 'news.public.empty'|trans }}</p>
            {% else %}
                <div class="row g-4">
                    {% for article in articles %}
                        <div class="col-12 col-md-6 col-lg-4">
                            <article class="card h-100 border-0 shadow-sm">
                                {% if article.coverPath %}
                                    <a href="{{ path('news_show', {slug: article.slug}) }}">
                                        <img src="{{ article.coverPath|imagine_filter('article_card') }}"
                                             alt="{{ article.title }}" class="card-img-top" />
                                    </a>
                                {% else %}
                                    <div class="ratio ratio-16x9 bg-light d-flex align-items-center justify-content-center">
                                        <twig:ux:icon name="bi:newspaper" class="text-muted" style="font-size: 3rem;" />
                                    </div>
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <h3 class="h5">
                                        <a href="{{ path('news_show', {slug: article.slug}) }}" class="text-decoration-none stretched-link">
                                            {{ article.title }}
                                        </a>
                                    </h3>
                                    {% if article.excerpt %}
                                        <p class="text-muted small">{{ article.excerpt }}</p>
                                    {% endif %}
                                    {% if article.publishedAt %}
                                        <p class="small text-muted mt-auto mb-0">
                                            <time datetime="{{ article.publishedAt|date('c') }}">
                                                {{ article.publishedAt|format_datetime(locale='nl', pattern='dd MMMM yyyy') }}
                                            </time>
                                        </p>
                                    {% endif %}
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>

                {% if totalPages > 1 %}
                    <nav class="d-flex justify-content-center mt-5" aria-label="{{ 'news.public.pagination'|trans }}">
                        <ul class="pagination">
                            <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                                <a class="page-link" href="{{ path('news_index', {page: max(1, currentPage - 1)}) }}">
                                    {{ 'news.public.prev'|trans }}
                                </a>
                            </li>
                            {% for p in 1..totalPages %}
                                <li class="page-item {{ p == currentPage ? 'active' }}">
                                    <a class="page-link" href="{{ path('news_index', {page: p}) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
                                <a class="page-link" href="{{ path('news_index', {page: min(totalPages, currentPage + 1)}) }}">
                                    {{ 'news.public.next'|trans }}
                                </a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            {% endif %}
        </div>
    </section>
{% endblock %}
