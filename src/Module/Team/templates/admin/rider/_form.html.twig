{{ form_start(form) }}
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                <div class="col-md-6">{{ form_row(form.lastName) }}</div>
            </div>
            <div class="row">
                <div class="col-md-6">{{ form_row(form.dateOfBirth) }}</div>
                <div class="col-md-6">{{ form_row(form.category) }}</div>
            </div>

            {% set rider = form.vars.data %}
            {% if rider is not null and rider.photoPath %}
                <div class="mb-3">
                    <label class="form-label d-block">{{ 'team.form.current_photo'|trans }}</label>
                    <img src="{{ rider.photoPath|imagine_filter('team_photo') }}"
                         alt="{{ rider.fullName }}"
                         style="max-height: 120px;" class="border rounded" />
                </div>
            {% endif %}

            {{ form_row(form.photoFile) }}
            {{ form_row(form.active) }}
        </div>
        <div class="card-footer d-flex justify-content-between bg-white border-top">
            <a href="{{ path('admin_rider_index') }}" class="btn btn-link">{{ 'admin.form.cancel'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ submitLabel|trans }}</button>
        </div>
    </div>
{{ form_end(form) }}
