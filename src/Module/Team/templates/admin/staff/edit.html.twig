{% extends '@Shared/admin/layout.html.twig' %}

{% block title %}{{ 'team.admin.staff.edit.title'|trans({'%name%': staff.fullName}) }}{% endblock %}

{% block admin_content %}
    <header class="admin-page-header mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <h1 class="admin-page-header__title">{{ 'team.admin.staff.edit.title'|trans({'%name%': staff.fullName}) }}</h1>
        <button type="button" class="btn btn-outline-secondary btn-sm"
                data-bs-toggle="offcanvas" data-bs-target="#admin-audit-trail">
            <twig:ux:icon name="bi:clock-history" /> {{ 'audit.title'|trans }}
        </button>
    </header>

    {% include '@Team/admin/staff/_form.html.twig' with {form: form, submitLabel: 'team.admin.actions.save'} %}

    {% include '@Shared/admin/_audit_offcanvas.html.twig' with {entity: staff} %}
{% endblock %}
