{% extends '@Shared/admin/layout.html.twig' %}

{% block title %}{{ 'uitslagen.admin.index.title'|trans }}{% endblock %}

{% block admin_content %}
    <header class="admin-page-header mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="admin-page-header__title">{{ 'uitslagen.admin.index.title'|trans }}</h1>
            <p class="admin-page-header__subtitle">{{ 'uitslagen.admin.index.subtitle'|trans }}</p>
        </div>
        {% if is_granted(enum('App\\Module\\Uitslagen\\Security\\UitslagenPermissions').create.value) %}
            <a href="{{ path('admin_result_create') }}" class="btn btn-primary">
                <twig:ux:icon name="bi:plus-lg" /> {{ 'uitslagen.admin.actions.create'|trans }}
            </a>
        {% endif %}
    </header>

    {% for label, messages in app.flashes(['success', 'danger']) %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if results is empty %}
        <p class="text-muted">{{ 'uitslagen.admin.empty'|trans }}</p>
    {% else %}
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'uitslagen.admin.table.race'|trans }}</th>
                            <th>{{ 'uitslagen.admin.table.date'|trans }}</th>
                            <th>{{ 'uitslagen.admin.table.rider'|trans }}</th>
                            <th class="text-center" style="width: 80px;">{{ 'uitslagen.admin.table.stage'|trans }}</th>
                            <th class="text-end" style="width: 80px;">{{ 'uitslagen.admin.table.rank'|trans }}</th>
                            <th class="text-end" style="width: 140px;">{{ 'uitslagen.admin.table.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for result in results %}
                            <tr>
                                <td><strong>{{ result.race.name }}</strong></td>
                                <td>{{ result.race.startDate|format_datetime(locale='nl', pattern='dd/MM/yyyy') }}</td>
                                <td>{{ result.rider.fullName }}</td>
                                <td class="text-center">
                                    {% if result.stageNumber %}
                                        <span class="badge bg-secondary-subtle text-secondary">{{ result.stageNumber }}</span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-end"><strong>{{ result.rank }}</strong></td>
                                <td class="text-end">
                                    {% if is_granted(enum('App\\Module\\Uitslagen\\Security\\UitslagenPermissions').edit.value, result) %}
                                        <a href="{{ path('admin_result_edit', {id: result.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <twig:ux:icon name="bi:pencil" />
                                        </a>
                                    {% endif %}
                                    {% if is_granted(enum('App\\Module\\Uitslagen\\Security\\UitslagenPermissions').delete.value, result) %}
                                        <form method="post" action="{{ path('admin_result_delete', {id: result.id}) }}"
                                              class="d-inline"
                                              data-controller="confirm"
                                              data-confirm-message-value="{{ 'uitslagen.admin.actions.confirm_delete'|trans({'%name%': result.race.name}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-result-' ~ result.id) }}" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <twig:ux:icon name="bi:trash" />
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
