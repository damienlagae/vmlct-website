{% extends '@Shared/base.html.twig' %}

{% block title %}{{ 'uitslagen.public.title'|trans }}{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container">
            <header class="text-center mb-4">
                <h1 class="section-title">{{ 'uitslagen.public.title'|trans }}</h1>
                <div class="title-underline mx-auto"></div>
                <p class="text-muted mt-3">{{ 'uitslagen.public.intro'|trans }}</p>
            </header>

            {% if results is empty %}
                <p class="text-muted text-center">{{ 'uitslagen.public.empty'|trans }}</p>
            {% else %}
                <div class="uitslagen-list">
                    {% for groupKey, groupResults in groups %}
                        {% set head = groupResults|first %}
                        {% set race = head.race %}
                        {% set stage = head.stageNumber %}
                        {% set sorted = groupResults|sort((a, b) => a.rank <=> b.rank) %}
                        {% set podium = sorted|slice(0, 3) %}
                        {% set rest = sorted|slice(3) %}

                        <article class="uitslagen-group">
                            <header class="uitslagen-group__header">
                                <div>
                                    <h2 class="uitslagen-group__title">
                                        {{ race.name }}
                                        {% if stage %}
                                            <span class="uitslagen-group__stage">— {{ 'uitslagen.public.stage'|trans({'%n%': stage}) }}</span>
                                        {% endif %}
                                    </h2>
                                    <p class="uitslagen-group__meta">
                                        <span><twig:ux:icon name="bi:calendar3" />
                                            {{ race.startDate|format_datetime(locale='nl', pattern='dd MMMM yyyy') }}
                                            {% if race.endDate and race.isMultiStage %}
                                                → {{ race.endDate|format_datetime(locale='nl', pattern='dd MMM yyyy') }}
                                            {% endif %}
                                        </span>
                                        <span><twig:ux:icon name="bi:geo-alt" /> {{ race.location }}</span>
                                        <span><twig:ux:icon name="bi:tag" /> {{ ('uitslagen.discipline.' ~ race.discipline.value)|trans }}</span>
                                    </p>
                                </div>
                                <span class="uitslagen-group__count">
                                    {{ groupResults|length }} {{ groupResults|length == 1 ? 'renner' : 'renners' }}
                                </span>
                            </header>

                            {% if podium|length > 0 %}
                                <div class="uitslagen-podium">
                                    {% for r in podium %}
                                        <div class="uitslagen-podium__slot uitslagen-podium__slot--rank{{ r.rank }}">
                                            <div class="uitslagen-podium__medal">
                                                {% if r.rank == 1 %}🥇{% elseif r.rank == 2 %}🥈{% elseif r.rank == 3 %}🥉{% else %}{{ r.rank }}{% endif %}
                                            </div>
                                            <div class="uitslagen-podium__name">{{ r.rider.fullName }}</div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if rest|length > 0 %}
                                <ul class="uitslagen-tail list-unstyled">
                                    {% for r in rest %}
                                        <li class="uitslagen-tail__item">
                                            <span class="uitslagen-tail__rank">{{ r.rank }}</span>
                                            <span class="uitslagen-tail__name">{{ r.rider.fullName }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
