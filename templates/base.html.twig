<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-100">
<head>
    {% block meta_tags %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{{ 'params.application.description' }}">
        <meta name="theme-color" content="#ffffff">
    {% endblock %}
    <title>{% block title %}Van Moer Logistics Cycling Team – Jeugdwielerploeg uit het Waasland{% endblock %}</title>
    {% block favicon %}
        <link rel="icon" type="image/png" href="{{ asset('img/favicon.png') }}" />
    {% endblock %}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="d-flex flex-column h-100">

        {% block header %}
            {{ include('_header.html.twig') }}
        {% endblock %}
        {% block main %}
        <main class="flex-shrink-0 mb-3">
            <div class="container">
                {% block body %}
                {% endblock %}
            </div>
        </main>
        {% endblock %}
        {% block footer %}
            {{ include('_footer.html.twig') }}
        {% endblock %}
    </body>
</html>
