<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-100">
<head>
    {% block meta_tags %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{{ 'app.description'|trans }}">
        <meta name="theme-color" content="#1a2857">
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

        <meta property="og:type" content="website">
        <meta property="og:locale" content="nl_BE">
        <meta property="og:title" content="{{ 'app.name'|trans }}">
        <meta property="og:description" content="{{ 'app.description'|trans }}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        <meta property="og:site_name" content="{{ 'app.name'|trans }}">
        <meta property="og:image" content="{{ absolute_url(asset('img/logo/van_moer_logistics_cycling_team.png')) }}">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ 'app.name'|trans }}">
        <meta name="twitter:description" content="{{ 'app.description'|trans }}">
        <meta name="twitter:image" content="{{ absolute_url(asset('img/logo/van_moer_logistics_cycling_team.png')) }}">
    {% endblock %}
    <title>{% block title %}{{ 'app.title'|trans }}{% endblock %}</title>
    {% block favicon %}
        <link rel="icon" type="image/png" href="{{ asset('img/favicon.png') }}" />
    {% endblock %}
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body class="d-flex flex-column h-100">
    {% block header %}
        {{ include('_header.html.twig') }}
    {% endblock %}

    <h1 class="visually-hidden">{{ 'app.title'|trans }}</h1>

    {% block main %}
        <main class="flex-shrink-0">
            {% block body %}{% endblock %}
        </main>
    {% endblock %}

    {% block footer %}
        {{ include('_footer.html.twig') }}
    {% endblock %}
</body>
</html>
